# ============================================================
# VARIABLES DE ENTORNO - PERIODICO LOCAL
# Copia este archivo como .env y rellena los valores reales
# NUNCA subas el archivo .env a un repositorio público
# ============================================================

# --- Base de datos PostgreSQL ---
POSTGRES_DB=periodico_db
POSTGRES_USER=periodico_user
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD_SEGURA

# --- Directus CMS ---
DIRECTUS_SECRET=GENERA_UN_SECRET_LARGO_Y_ALEATORIO_AQUI
DIRECTUS_ADMIN_EMAIL=admin@tuperiodico.es
DIRECTUS_ADMIN_PASSWORD=CAMBIA_ESTA_PASSWORD_ADMIN

# --- URLs públicas ---
PUBLIC_DIRECTUS_URL=https://cms.tudominio.es
PUBLIC_DIRECTUS_PUBLIC_URL=https://cms.tudominio.es
FRONTEND_URL=https://tudominio.es

# --- Caddy / Dominios ---
DOMAIN=tudominio.es
CMS_DOMAIN=cms.tudominio.es
STATS_DOMAIN=stats.tudominio.es

# --- Umami Analytics ---
UMAMI_DB_NAME=umami_db
UMAMI_DB_USER=umami_user
UMAMI_DB_PASSWORD=CAMBIA_ESTA_PASSWORD_UMAMI
UMAMI_SECRET=GENERA_UN_SECRET_LARGO_PARA_UMAMI
PUBLIC_UMAMI_URL=https://stats.tudominio.es
PUBLIC_UMAMI_WEBSITE_ID=PEGA_AQUI_EL_ID_DEL_SITIO_DE_UMAMI

# --- Backups ---
BACKUP_RETENTION_DAYS=30
