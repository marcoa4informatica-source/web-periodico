---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Map from '@/components/Map.astro';
import { getPuntosVenta, getTiposPuntoVenta, getConfiguracion } from '@/lib/directus';
import { PUNTOS_SALAOS } from '@/lib/puntosSalaos';

let puntosDirectus = [];
let tiposDirectus = [];
let config = { nombre_periodico: 'La Sal de El Puerto', descripcion: '', logo: null, email: '', telefono: null, direccion: null };

try {
  [puntosDirectus, tiposDirectus, config] = await Promise.all([getPuntosVenta(), getTiposPuntoVenta(), getConfiguracion()]);
} catch {
  // Directus no disponible, se usan datos estáticos
}

// Usar Directus si tiene datos, si no los estáticos
const puntos = puntosDirectus.length > 0 ? puntosDirectus : PUNTOS_SALAOS;

const lat = puntos.reduce((s, p) => s + p.latitud, 0) / puntos.length;
const lng = puntos.reduce((s, p) => s + p.longitud, 0) / puntos.length;

// Construir grupos dinámicamente desde Directus
const tiposFallback = [
  { slug: 'libreria',   label: 'Librerías y Papelerías', emoji: '📚', orden: 1 },
  { slug: 'bar',        label: 'Bares y Cafeterías',     emoji: '☕', orden: 2 },
  { slug: 'asociacion', label: 'Asociaciones y Sedes',   emoji: '🏘️', orden: 3 },
  { slug: 'otro',       label: 'Otros',                  emoji: '📍', orden: 99 },
];
const tipos = tiposDirectus.length > 0 ? tiposDirectus : tiposFallback;

const gruposMap: Record<string, { label: string; emoji: string; orden: number; items: typeof puntos }> = {};
tipos.forEach((t) => {
  gruposMap[t.slug] = { label: t.label, emoji: t.emoji, orden: t.orden, items: [] };
});

puntos.forEach((p) => {
  const tipo = (p.tipo_id as any)?.slug ?? p.tipo ?? 'otro';
  if (gruposMap[tipo]) {
    gruposMap[tipo].items.push(p);
  } else {
    gruposMap[tipo] = { label: tipo, emoji: '📍', orden: 98, items: [p] };
  }
});

const grupos = Object.values(gruposMap).sort((a, b) => a.orden - b.orden);
---

<BaseLayout title="Encuéntranos" description="Puntos de venta de La Sal de El Puerto en El Puerto de Santa María">
  <div class="container-main py-12">

    <header class="mb-10">
      <h1 class="section-title-decorated">Puntos Salaos</h1>
      <p class="section-subtitle mt-6">
        Encuentra <strong>La Sal de El Puerto</strong> en {puntos.length} puntos repartidos por El Puerto de Santa María
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">

      <!-- Mapa Leaflet -->
      <div class="lg:col-span-2">
        <Map puntos={puntos} lat={lat} lng={lng} zoom={13} />
        <p class="text-xs text-neutral-500 mt-2 text-center">
          Haz clic en cada marcador para ver la dirección
        </p>
        <!-- Alternativa accesible al mapa para lectores de pantalla -->
        <details class="mt-4 sr-only focus-within:not-sr-only">
          <summary class="text-sm font-semibold text-neutral-700 cursor-pointer">Ver lista de puntos de venta (accesible)</summary>
          <ul class="mt-3 space-y-2 text-sm text-neutral-600">
            {puntos.map((p) => (
              <li><strong>{p.nombre}</strong> — {p.direccion}</li>
            ))}
          </ul>
        </details>
      </div>

      <!-- Lista agrupada por tipo -->
      <div class="space-y-6">
        {grupos.filter(g => g.items.length > 0).map((grupo) => (
          <div>
            <h2 class="flex items-center gap-2 font-heading font-bold text-sm text-neutral-900 uppercase tracking-wider mb-3 pb-2 border-b-2 border-accent">
              <span aria-hidden="true">{grupo.emoji}</span>
              {grupo.label}
              <span class="text-neutral-600 font-normal normal-case tracking-normal ml-auto text-xs">({grupo.items.length})</span>
            </h2>
            <ul class="space-y-2">
              {grupo.items.slice(0, 2).map((p) => (
                <li class="text-sm">
                  <p class="font-heading font-semibold text-neutral-900 leading-tight">{p.nombre}</p>
                  <p class="text-neutral-600 text-xs mt-0.5">{p.direccion}</p>
                </li>
              ))}
            </ul>
            {grupo.items.length > 2 && (
              <details class="mt-2 group/det">
                <summary class="text-xs font-semibold text-neutral-600 hover:text-accent cursor-pointer transition-colors py-1 select-none list-none flex items-center gap-1">
                  <svg class="w-3 h-3 shrink-0 transition-transform group-open/det:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                  <span class="ver-mas-label">Ver {grupo.items.length - 2} más…</span>
                  <span class="ver-menos-label">Ver menos</span>
                </summary>
                <ul class="mt-2 space-y-2">
                  {grupo.items.slice(2).map((p) => (
                    <li class="text-sm">
                      <p class="font-heading font-semibold text-neutral-900 leading-tight">{p.nombre}</p>
                      <p class="text-neutral-600 text-xs mt-0.5">{p.direccion}</p>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </div>
        ))}

        <!-- CTA contacto -->
        {config.email && (
          <div class="p-4 bg-neutral-900 rounded-xl text-white">
            <p class="text-accent text-xs font-heading font-semibold uppercase tracking-wider mb-1">¿Quieres ser punto de venta?</p>
            <p class="text-neutral-400 text-xs mb-3 font-sans">Contacta con nosotros y te informamos.</p>
            <a href={`mailto:${config.email}`} class="btn-primary text-xs px-4 py-2">
              Escribir correo
            </a>
          </div>
        )}
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .ver-menos-label { display: none; }
  details[open] .ver-mas-label   { display: none; }
  details[open] .ver-menos-label { display: inline; }
  details > summary { list-style: none; }
  details > summary::-webkit-details-marker { display: none; }
</style>
