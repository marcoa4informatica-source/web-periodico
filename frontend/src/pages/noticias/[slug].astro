---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getNoticia, getImageUrl, getNoticias } from '@/lib/directus';

const { slug } = Astro.params;

let noticia = null;
let relacionadas = [];
try {
  noticia = await getNoticia(slug!);
  if (noticia) {
    relacionadas = (await getNoticias(4)).filter((n) => n.slug !== slug).slice(0, 3);
  }
} catch {
  // Directus no disponible
}

if (!noticia) {
  return Astro.redirect('/noticias', 302);
}

const imageUrl = getImageUrl(noticia.imagen_destacada, 1200, 630);
const categoria = noticia.categoria;
const autor = noticia.autor;
const fecha = new Date(noticia.fecha_publicacion).toLocaleDateString('es-ES', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
});
---

<BaseLayout
  title={noticia.seo_title ?? noticia.titulo}
  description={noticia.seo_description ?? noticia.resumen}
  ogImage={imageUrl}
>
  <article class="container-main py-12 max-w-4xl">

    <!-- Cabecera -->
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-4">
        {categoria && (
          <a href="/noticias" class="text-xs font-semibold text-primary-700 bg-primary-50 px-3 py-1 rounded-full uppercase tracking-wide hover:bg-primary-100 transition-colors">
            {categoria}
          </a>
        )}
        <span class="text-sm text-neutral-600 capitalize">{fecha}</span>
      </div>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-neutral-900 leading-tight mb-4">
        {noticia.titulo}
      </h1>
      <p class="text-lg text-neutral-600 leading-relaxed">{noticia.resumen}</p>
      {autor && (
        <p class="text-sm text-neutral-400 mt-3">Por <span class="font-semibold text-neutral-600">{autor}</span></p>
      )}
    </header>

    <!-- Imagen destacada -->
    {imageUrl && (
      <figure class="mb-8 -mx-4 sm:mx-0">
        <img
          src={imageUrl}
          alt={noticia.titulo}
          class="w-full h-72 md:h-[480px] object-cover rounded-xl"
        />
      </figure>
    )}

    <!-- Contenido -->
    <div class="prose-periodico" set:html={noticia.contenido} />

    <!-- Compartir -->
    <div class="border-t border-neutral-200 mt-10 pt-6 flex items-center gap-4">
      <span class="text-sm text-neutral-500 font-medium">Compartir:</span>
      <a
        href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(noticia.titulo)}`}
        target="_blank" rel="noopener noreferrer"
        class="text-sm text-neutral-500 hover:text-neutral-800 transition-colors"
      >X / Twitter</a>
      <a
        href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}
        target="_blank" rel="noopener noreferrer"
        class="text-sm text-neutral-500 hover:text-neutral-800 transition-colors"
      >Facebook</a>
    </div>
  </article>

  <!-- Noticias relacionadas -->
  {relacionadas.length > 0 && (
    <section class="bg-neutral-50 py-12 mt-4">
      <div class="container-main">
        <h2 class="section-title">Más noticias</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-6">
          {relacionadas.map((n) => {
            const img = getImageUrl(n.imagen_destacada, 400, 250);
            return (
              <a href={`/noticias/${n.slug}`} class="group card flex flex-col overflow-hidden">
                {img
                  ? <img src={img} alt={n.titulo} class="w-full h-36 object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                  : <div class="w-full h-36 bg-neutral-200" />
                }
                <div class="p-4">
                  <h3 class="font-serif font-bold text-sm text-neutral-900 group-hover:text-primary-700 transition-colors line-clamp-2">{n.titulo}</h3>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
