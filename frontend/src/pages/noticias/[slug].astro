---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getNoticia, getImageUrl, getNoticias } from '@/lib/directus';

const { slug } = Astro.params;

let noticia = null;
let relacionadas = [];
try {
  noticia = await getNoticia(slug!);
  if (noticia) {
    relacionadas = (await getNoticias(4)).filter((n) => n.slug !== slug).slice(0, 3);
  }
} catch {
  // Directus no disponible
}

if (!noticia) {
  return Astro.redirect('/noticias', 302);
}

const imageUrl = getImageUrl(noticia.imagen_destacada, 1200, 630);
const categoria = noticia.categoria;
const autor = noticia.autor;
const fecha = new Date(noticia.fecha_publicacion).toLocaleDateString('es-ES', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
});
---

<BaseLayout
  title={noticia.seo_title ?? noticia.titulo}
  description={noticia.seo_description ?? noticia.resumen}
  ogImage={imageUrl}
>
  <article class="container-main py-12 max-w-4xl">

    <!-- Cabecera -->
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-4">
        {categoria && (
          <a href="/noticias" class="text-xs font-semibold text-primary-700 bg-primary-50 px-3 py-1 rounded-full uppercase tracking-wide hover:bg-primary-100 transition-colors">
            {categoria}
          </a>
        )}
        <span class="text-sm text-neutral-600 capitalize">{fecha}</span>
      </div>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-neutral-900 leading-tight mb-4">
        {noticia.titulo}
      </h1>
      <p class="text-lg text-neutral-600 leading-relaxed">{noticia.resumen}</p>
      {autor && (
        <p class="text-sm text-neutral-600 mt-3">Por <span class="font-semibold text-neutral-700">{autor}</span></p>
      )}
    </header>

    <!-- Imagen destacada -->
    {imageUrl && (
      <figure class="mb-8 -mx-4 sm:mx-0">
        <img
          src={imageUrl}
          alt={noticia.titulo}
          class="w-full h-72 md:h-[480px] object-cover rounded-xl"
        />
      </figure>
    )}

    <!-- Contenido -->
    <div class="prose-periodico" set:html={noticia.contenido} />

    <!-- Compartir -->
    <div class="border-t border-neutral-200 mt-10 pt-6 flex items-center gap-3 flex-wrap">
      <span class="text-sm text-neutral-500 font-medium mr-1">Compartir:</span>
      <a
        href={`https://x.com/intent/tweet?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(noticia.titulo)}`}
        target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-neutral-900 text-white text-sm font-semibold hover:bg-neutral-700 transition-colors"
        title="Compartir en X"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        X
      </a>
      <a
        href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}
        target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-[#1877F2] text-white text-sm font-semibold hover:bg-[#1464d8] transition-colors"
        title="Compartir en Facebook"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
        Facebook
      </a>
    </div>
  </article>

  <!-- Noticias relacionadas -->
  {relacionadas.length > 0 && (
    <section class="bg-neutral-50 py-12 mt-4">
      <div class="container-main">
        <h2 class="section-title">Más noticias</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-6">
          {relacionadas.map((n) => {
            const img = getImageUrl(n.imagen_destacada, 400, 250);
            return (
              <a href={`/noticias/${n.slug}`} class="group card flex flex-col overflow-hidden">
                {img
                  ? <img src={img} alt="" class="w-full h-36 object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                  : <div class="w-full h-36 bg-neutral-200" />
                }
                <div class="p-4">
                  <h3 class="font-serif font-bold text-sm text-neutral-900 group-hover:text-primary-700 transition-colors line-clamp-2">{n.titulo}</h3>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
