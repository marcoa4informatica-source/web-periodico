---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe o ha sido movida.">
  <div class="container-main py-24 text-center max-w-2xl mx-auto">

    <p class="font-display text-8xl md:text-9xl text-accent leading-none mb-4" aria-hidden="true">404</p>

    <h1 class="font-heading text-2xl md:text-3xl font-bold text-neutral-900 mb-4">
      Página no encontrada
    </h1>
    <p class="text-neutral-600 leading-relaxed mb-10">
      La página que buscas no existe, ha sido movida o la dirección está mal escrita.
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a href="/" class="btn-primary">
        Ir a inicio
      </a>
      <a href="/noticias" class="btn-secondary">
        Ver noticias
      </a>
    </div>

  </div>
</BaseLayout>
