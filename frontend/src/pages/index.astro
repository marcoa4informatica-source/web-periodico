---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsCard from '@/components/NewsCard.astro';
import EditionCard from '@/components/EditionCard.astro';
import { getNoticias, getNoticiasDestacadas, getUltimaEdicion, getAssetUrl } from '@/lib/directus';

let noticiasDestacadas = [];
let noticias = [];
let ultimaEdicion = null;

try {
  [noticiasDestacadas, noticias, ultimaEdicion] = await Promise.all([
    getNoticiasDestacadas(),
    getNoticias(6),
    getUltimaEdicion(),
  ]);
} catch {
  // Directus no disponible
}
---

<BaseLayout title="Inicio" description="Periódico local de tu municipio. Noticias, ediciones digitales y más.">

  <!-- Hero / Últimas noticias destacadas -->
  <section class="bg-white border-b-2 border-accent py-10">
    <div class="container-main">
      {noticiasDestacadas.length > 0 ? (
        <div class="grid grid-cols-1 gap-6">
          <NewsCard noticia={noticiasDestacadas[0]} featured={true} />
          {noticiasDestacadas.length > 1 && (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {noticiasDestacadas.slice(1).map((n) => <NewsCard noticia={n} />)}
            </div>
          )}
        </div>
      ) : (
        <div class="text-center py-20">
          <svg class="w-16 h-16 text-neutral-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
          </svg>
          <h2 class="text-xl font-heading text-neutral-600 mb-2">Próximamente las últimas noticias</h2>
          <p class="text-neutral-400">Estamos preparando el contenido. Vuelve pronto.</p>
        </div>
      )}
    </div>
  </section>

  <!-- Más noticias -->
  {noticias.length > 0 && (
    <section class="py-12">
      <div class="container-main">
        <h2 class="section-title-decorated">Últimas noticias</h2>
        <p class="section-subtitle mt-6">La actualidad de El Puerto de Santa María</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {noticias.map((n) => <NewsCard noticia={n} />)}
        </div>
        <div class="mt-8 text-center">
          <a href="/noticias" class="btn-secondary">Ver todas las noticias</a>
        </div>
      </div>
    </section>
  )}

  <!-- Última edición -->
  {ultimaEdicion && (
    <section class="bg-neutral-900 text-white py-12 border-t-4 border-accent">
      <div class="container-main">
        <div class="flex flex-col md:flex-row items-center gap-8">
          <div class="flex-1">
            <span class="text-accent text-sm font-heading font-semibold uppercase tracking-wider">Última edición</span>
            <h2 class="font-heading text-3xl font-bold mt-2 mb-3">{ultimaEdicion.titulo}</h2>
            <p class="text-neutral-300 mb-6 font-sans">{ultimaEdicion.descripcion}</p>
            <div class="flex flex-wrap gap-3">
              {getAssetUrl(ultimaEdicion.pdf_file) && (
                <a
                  href={getAssetUrl(ultimaEdicion.pdf_file)!}
                  target="_blank"
                  rel="noopener noreferrer"
                  download
                  class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-neutral-900 font-heading font-bold rounded-md hover:bg-accent-dark transition-colors"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                  </svg>
                  Descargar PDF gratis
                </a>
              )}
              <a href="/archivo" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-neutral-400 text-white font-heading font-bold rounded-md hover:border-accent hover:text-accent transition-colors">
                Ver archivo completo
              </a>
            </div>
          </div>
          {ultimaEdicion.portada && (
            <div class="shrink-0">
              <img
                src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${ultimaEdicion.portada}?width=200&format=webp`}
                alt={`Portada ${ultimaEdicion.titulo}`}
                class="w-40 rounded-lg shadow-xl border-4 border-white"
                loading="lazy"
              />
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Hazte socio CTA -->
  <section class="py-14 bg-accent-light">
    <div class="container-main text-center max-w-2xl mx-auto">
      <h2 class="section-title-decorated inline-block">Apoya el periodismo local</h2>
      <p class="text-neutral-600 leading-relaxed mb-6">
        Somos el periódico de tu municipio. Con tu apoyo como socio ayudas a mantener viva la información local independiente.
      </p>
      <a href="/hazte-socio" class="btn-primary text-base px-8 py-3">Hazte socio</a>
    </div>
  </section>

</BaseLayout>
