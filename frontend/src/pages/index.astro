---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsCard from '@/components/NewsCard.astro';
import EditionCard from '@/components/EditionCard.astro';
import { getNoticias, getNoticiasDestacadas, getEdicionesDestacadas, getUltimaEdicion, getAssetUrl, getImageUrl } from '@/lib/directus';

let noticiaDestacada = null;
let edicionDestacada = null;
let noticias = [];
let ultimaEdicion = null;

try {
  const [noticiasDestacadas, edicionesDestacadas, noticiasResult, ultimaEdicionResult] = await Promise.all([
    getNoticiasDestacadas(),
    getEdicionesDestacadas(),
    getNoticias(6),
    getUltimaEdicion(),
  ]);
  noticias = noticiasResult;
  ultimaEdicion = ultimaEdicionResult;

  // Elegir el destacado más reciente entre noticias y ediciones
  const ultimaNoticiaDestacada = noticiasDestacadas[0] ?? null;
  const ultimaEdicionDestacada = edicionesDestacadas[0] ?? null;

  if (ultimaNoticiaDestacada && ultimaEdicionDestacada) {
    const fechaNoticia = new Date(ultimaNoticiaDestacada.fecha_publicacion);
    const fechaEdicion = new Date(ultimaEdicionDestacada.fecha_publicacion);
    if (fechaEdicion > fechaNoticia) {
      edicionDestacada = ultimaEdicionDestacada;
    } else {
      noticiaDestacada = ultimaNoticiaDestacada;
    }
  } else {
    noticiaDestacada = ultimaNoticiaDestacada;
    edicionDestacada = ultimaEdicionDestacada;
  }
} catch {
  // Directus no disponible
}
---

<BaseLayout title="Inicio" description="Periódico local de tu municipio. Noticias, ediciones digitales y más.">

  <!-- Destacado — la noticia o edición más reciente marcada como destacada -->
  <section class="bg-white border-b-2 border-accent py-10">
    <div class="container-main">
      {noticiaDestacada ? (
        <NewsCard noticia={noticiaDestacada} featured={true} />
      ) : edicionDestacada ? (
        <div>
          <p class="text-xs font-heading font-semibold uppercase tracking-widest text-accent mb-4">Edición destacada</p>
          <EditionCard edicion={edicionDestacada} />
        </div>
      ) : (
        <div class="text-center py-20">
          <svg class="w-16 h-16 text-neutral-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
          </svg>
          <h2 class="text-xl font-heading text-neutral-600 mb-2">Próximamente las últimas noticias</h2>
          <p class="text-neutral-600">Estamos preparando el contenido. Vuelve pronto.</p>
        </div>
      )}
    </div>
  </section>

  <!-- Más noticias -->
  {noticias.length > 0 && (
    <section class="py-12">
      <div class="container-main">
        <h2 class="section-title-decorated">Últimas noticias</h2>
        <p class="section-subtitle mt-6">La actualidad de El Puerto de Santa María</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {noticias.map((n) => <NewsCard noticia={n} />)}
        </div>
        <div class="mt-8 text-center">
          <a href="/noticias" class="btn-secondary">Ver todas las noticias</a>
        </div>
      </div>
    </section>
  )}

  <!-- Última edición -->
  {ultimaEdicion && (
    <section class="bg-neutral-900 text-white py-12 border-t-4 border-accent">
      <div class="container-main">
        <div class="flex flex-col md:flex-row items-center gap-8">
          <div class="flex-1">
            <span class="text-accent text-sm font-heading font-semibold uppercase tracking-wider">Última edición</span>
            <h2 class="font-heading text-3xl font-bold mt-2 mb-3">{ultimaEdicion.titulo}</h2>
            <p class="text-neutral-300 mb-6 font-sans">{ultimaEdicion.descripcion}</p>
            <div class="flex flex-wrap gap-3">
              {getAssetUrl(ultimaEdicion.pdf_file) && (
                <>
                  <a
                    href={getAssetUrl(ultimaEdicion.pdf_file)!}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-neutral-900 font-heading font-bold rounded-md hover:bg-accent-dark transition-colors"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                    Leer online gratis
                  </a>
                  <a
                    href={getAssetUrl(ultimaEdicion.pdf_file)!}
                    target="_blank"
                    rel="noopener noreferrer"
                    download
                    class="inline-flex items-center gap-2 px-6 py-3 border-2 border-neutral-400 text-white font-heading font-bold rounded-md hover:border-accent hover:text-accent transition-colors"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                    </svg>
                    Descargar PDF
                  </a>
                </>
              )}
              <a href="/archivo" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-neutral-400 text-white font-heading font-bold rounded-md hover:border-accent hover:text-accent transition-colors">
                Ver todas las ediciones
              </a>
            </div>
          </div>
          {ultimaEdicion.portada && (
            <div class="shrink-0">
              <img
                src={getImageUrl(ultimaEdicion.portada, 200, 280)!}
                alt={`Portada ${ultimaEdicion.titulo}`}
                class="w-40 rounded-lg shadow-xl border-4 border-white"
                loading="lazy"
              />
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Hazte socio CTA -->
  <section class="py-14 bg-accent-light">
    <div class="container-main text-center max-w-2xl mx-auto">
      <h2 class="section-title-decorated inline-block">Apoya el periodismo local</h2>
      <p class="text-neutral-600 leading-relaxed mb-6">
        Somos el periódico de tu municipio. Con tu apoyo como socio ayudas a mantener viva la información local independiente.
      </p>
      <a href="/hazte-socio" class="btn-primary text-base px-8 py-3">Hazte socio</a>
    </div>
  </section>

</BaseLayout>
