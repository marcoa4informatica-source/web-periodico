---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EditionCard from '@/components/EditionCard.astro';
import { getEdiciones, getAniosEdiciones } from '@/lib/directus';

const anioParam = Astro.url.searchParams.get('anio');
const anioFiltro = anioParam ? Number(anioParam) : undefined;

let ediciones = [];
let anios: number[] = [];
try {
  [ediciones, anios] = await Promise.all([
    getEdiciones(anioFiltro),
    getAniosEdiciones(),
  ]);
} catch {
  // Directus no disponible
}
---

<BaseLayout title="Archivo de ediciones" description="Descarga todas las ediciones del periódico en PDF">
  <div class="container-main py-12">
    <header class="mb-10">
      <h1 class="section-title">Archivo de ediciones</h1>
      <p class="section-subtitle">Descarga cualquier edición en PDF de forma gratuita</p>

      <!-- Filtro por año -->
      {anios.length > 1 && (
        <div class="flex flex-wrap gap-2 mt-4">
          <a
            href="/archivo"
            class={`px-4 py-1.5 rounded-full text-sm font-medium transition-colors
              ${!anioFiltro ? 'bg-primary-700 text-white' : 'bg-neutral-100 text-neutral-600 hover:bg-neutral-200'}`}
          >
            Todos
          </a>
          {anios.map((a) => (
            <a
              href={`/archivo?anio=${a}`}
              class={`px-4 py-1.5 rounded-full text-sm font-medium transition-colors
                ${anioFiltro === a ? 'bg-primary-700 text-white' : 'bg-neutral-100 text-neutral-600 hover:bg-neutral-200'}`}
            >
              {a}
            </a>
          ))}
        </div>
      )}
    </header>

    {ediciones.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {ediciones.map((e) => <EditionCard edicion={e} />)}
      </div>
    ) : (
      <div class="text-center py-20">
        <svg class="w-16 h-16 text-neutral-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <h2 class="text-xl font-serif text-neutral-600 mb-2">No hay ediciones publicadas</h2>
        <p class="text-neutral-400">Las ediciones aparecerán aquí cuando sean publicadas.</p>
      </div>
    )}
  </div>
</BaseLayout>
