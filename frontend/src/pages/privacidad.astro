---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPagina } from '@/lib/directus';

let pagina = null;
try { pagina = await getPagina('privacidad'); } catch {}
---

<BaseLayout title={pagina?.titulo ?? 'Política de privacidad'} description="Política de privacidad del periódico">
  <div class="container-main py-12 max-w-3xl">
    <h1 class="section-title">{pagina?.titulo ?? 'Política de privacidad'}</h1>
    {pagina?.contenido
      ? <div class="prose-periodico mt-8" set:html={pagina.contenido} />
      : <p class="text-neutral-500 mt-8">Este contenido puede editarse desde el panel de administración → Páginas → privacidad.</p>
    }
  </div>
</BaseLayout>
