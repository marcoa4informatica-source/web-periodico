---
import type { ConfiguracionWeb } from '@/lib/directus';
import { getImageUrl } from '@/lib/directus';

interface Props {
  config: ConfiguracionWeb;
}

const { config } = Astro.props;
const logoUrl = config.logo ? getImageUrl(config.logo, 400, 130) : null;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/noticias', label: 'Noticias' },
  { href: '/archivo', label: 'Ediciones' },
  { href: '/nosotras', label: 'Nosotras' },
  { href: '/unete', label: 'Únete' },
  { href: '/encuentranos', label: 'Encuéntranos' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const fechaHoy = new Date().toLocaleDateString('es-ES', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
});
---

<header class="sticky top-0 z-50 shadow-lg">

  <!-- Masthead amarillo: logo desborda sobre la barra negra para máxima presencia -->
  <div class="bg-accent overflow-visible relative z-10">
    <div class="container-main pt-0 pb-0 flex items-end justify-between gap-6 overflow-visible">

      <!-- Logo: imagen visual (pointer-events-none) + click target limitado a la banda -->
      <div class="shrink-0 relative z-20">
        <!-- Click target: solo cubre el área visible dentro de la banda amarilla -->
        <a href="/"
           class="absolute inset-x-0 top-0 z-10"
           style="bottom: 3.5rem;"
           aria-label={config.nombre_periodico || 'La Sal de El Puerto'}
        ></a>
        <!-- Imagen visual: desborda hacia abajo pero no intercepta clicks -->
        {logoUrl ? (
          <img
            src={logoUrl}
            alt=""
            class="h-40 md:h-48 w-auto -mt-6 -mb-14 md:-mb-16 pointer-events-none"
            style="mix-blend-mode: multiply;"
          />
        ) : (
          <img
            src="/logoB.png"
            alt=""
            class="h-40 md:h-48 w-auto -mt-6 -mb-14 md:-mb-16 pointer-events-none"
            style="mix-blend-mode: multiply;"
          />
        )}
      </div>

      <!-- Fecha + tagline: lado derecho del masthead -->
      <div class="hidden md:flex flex-col items-end gap-0.5 pb-3">
        <p class="font-sans text-neutral-700 text-xs tracking-widest">
          Periódico Independiente
        </p>
        <p class="font-display text-neutral-900 text-lg leading-none tracking-wide uppercase">
          Tu comunidad en papel
        </p>
        <p class="font-sans text-neutral-700 text-xs tracking-wide capitalize">
          {fechaHoy}
        </p>
      </div>

      <!-- Botón hamburguesa móvil -->
      <button
        id="menu-toggle"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="main-nav"
        class="lg:hidden p-2 rounded-md text-neutral-800 hover:bg-accent-dark transition-colors ml-auto"
      >
        <svg id="icon-open" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Navegación negra -->
  <nav id="main-nav" aria-label="Navegación principal" class="hidden lg:block bg-neutral-900 relative z-0">
    <div class="container-main flex items-center justify-between">
      <ul class="flex flex-col lg:flex-row">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class={`block px-5 py-3.5 text-sm font-heading font-semibold tracking-wide transition-colors
                      ${isActive(href)
                        ? 'text-accent bg-neutral-800'
                        : 'text-neutral-300 hover:text-accent hover:bg-neutral-800'}`}
            aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href="https://www.instagram.com/lasaldeelpuerto"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram de La Sal de El Puerto"
        class="flex items-center gap-2 px-4 py-2 text-neutral-400 hover:text-white transition-colors text-xs font-semibold tracking-wide"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
        @lasaldeelpuerto
      </a>
    </div>
  </nav>

</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('main-nav');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
