---
import type { Edicion } from '@/lib/directus';
import { getImageUrl, getAssetUrl } from '@/lib/directus';

interface Props {
  edicion: Edicion;
}

const { edicion } = Astro.props;
const portadaUrl = getImageUrl(edicion.portada, 300, 420);
const pdfUrl = getAssetUrl(edicion.pdf_file);
const fecha = new Date(edicion.fecha_publicacion).toLocaleDateString('es-ES', {
  month: 'long', year: 'numeric',
});
---

<article class="card group flex flex-col">
  <!-- Portada -->
  <div class="relative overflow-hidden bg-neutral-100">
    {portadaUrl
      ? <img
          src={portadaUrl}
          alt={`Portada edición ${edicion.numero}`}
          class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
      : <div class="w-full h-56 flex items-center justify-center bg-neutral-100">
          <svg class="w-16 h-16 text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
    }
    <span class="absolute top-3 left-3 bg-primary-700 text-white text-xs font-bold px-2.5 py-1 rounded-full">
      Nº {edicion.numero}
    </span>
  </div>

  <!-- Info -->
  <div class="p-5 flex flex-col flex-1">
    <h3 class="font-serif font-bold text-neutral-900 mb-1 leading-snug line-clamp-2">{edicion.titulo}</h3>
    <p class="text-xs text-neutral-500 mb-2 capitalize">{fecha}</p>
    {edicion.descripcion && (
      <p class="text-sm text-neutral-500 leading-relaxed line-clamp-2 flex-1">{edicion.descripcion}</p>
    )}

    <!-- Botón descargar -->
    {pdfUrl && (
      <a
        href={pdfUrl}
        target="_blank"
        rel="noopener noreferrer"
        download
        class="btn-primary mt-4 justify-center"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Descargar PDF
      </a>
    )}
  </div>
</article>
