---
import type { Edicion } from '@/lib/directus';
import { getImageUrl, getAssetUrl } from '@/lib/directus';

interface Props {
  edicion: Edicion;
}

const { edicion } = Astro.props;
const portadaUrl = getImageUrl(edicion.portada, 300, 420);
const pdfUrl = getAssetUrl(edicion.pdf_file);
const pdfDownloadUrl = pdfUrl ? `${pdfUrl}?download` : null;
const fecha = new Date(edicion.fecha_publicacion).toLocaleDateString('es-ES', {
  month: 'long', year: 'numeric',
});
---

<article class="card group flex flex-col edition-card-share">
  <!-- Portada -->
  <div class="relative overflow-hidden bg-neutral-100 aspect-[3/4]">
    {portadaUrl
      ? <img
          src={portadaUrl}
          alt={`Portada edición ${edicion.numero}`}
          class="absolute inset-0 w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
      : <div class="absolute inset-0 flex items-center justify-center bg-neutral-100">
          <svg class="w-16 h-16 text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
    }
    <span class="absolute top-3 left-3 bg-primary-700 text-white text-xs font-bold px-2.5 py-1 rounded-full">
      Nº {edicion.numero}
    </span>
  </div>

  <!-- Info -->
  <div class="p-5 flex flex-col flex-1">
    <h3 class="font-serif font-bold text-neutral-900 mb-1 leading-snug line-clamp-2">{edicion.titulo}</h3>
    <p class="text-xs text-neutral-600 mb-2 capitalize">{fecha}</p>
    {edicion.descripcion && (
      <p class="text-sm text-neutral-600 leading-relaxed line-clamp-2 flex-1">{edicion.descripcion}</p>
    )}

    <!-- Botones PDF -->
    {pdfUrl && (
      <div class="flex gap-2 mt-4">
        <a
          href={pdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary flex-1 justify-center"
          aria-label={`Leer online: ${edicion.titulo}`}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
          Leer online
        </a>
        <a
          href={pdfDownloadUrl!}
          rel="noopener noreferrer"
          download
          class="btn-secondary px-3 justify-center"
          aria-label={`Descargar PDF: ${edicion.titulo}`}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
        </a>
      </div>
    )}

    <!-- Compartir -->
    <div class="flex gap-2 mt-3 pt-3 border-t border-neutral-100">
      <span class="text-xs text-neutral-600 self-center mr-1">Compartir:</span>
      <button
        type="button"
        data-share-x
        data-titulo={edicion.titulo}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-neutral-900 text-white text-xs font-semibold hover:bg-neutral-700 transition-colors cursor-pointer"
        aria-label={`Compartir "${edicion.titulo}" en X`}
      >
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        X
      </button>
      <button
        type="button"
        data-share-fb
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-[#1877F2] text-white text-xs font-semibold hover:bg-[#1464d8] transition-colors cursor-pointer"
        aria-label={`Compartir "${edicion.titulo}" en Facebook`}
      >
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
        Facebook
      </button>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll('.edition-card-share').forEach((card) => {
    const pageUrl = window.location.origin + '/archivo';
    const xBtn = card.querySelector('[data-share-x]') as HTMLButtonElement | null;
    const fbBtn = card.querySelector('[data-share-fb]') as HTMLButtonElement | null;
    if (xBtn) {
      const titulo = xBtn.dataset.titulo ?? '';
      xBtn.addEventListener('click', () => {
        window.open(`https://x.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(titulo)}`, '_blank', 'noopener,noreferrer');
      });
    }
    if (fbBtn) {
      fbBtn.addEventListener('click', () => {
        window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`, '_blank', 'noopener,noreferrer');
      });
    }
  });
</script>
