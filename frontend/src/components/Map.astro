---
import type { PuntoVenta } from '@/lib/directus';
import type { PuntoSalao } from '@/lib/puntosSalaos';

interface Props {
  puntos: (PuntoVenta | PuntoSalao)[];
  lat?: number;
  lng?: number;
  zoom?: number;
}

const { puntos, lat = 36.5933, lng = -6.2332, zoom = 13 } = Astro.props;
---

<div id="mapa-puntos" class="w-full h-96 md:h-[520px] rounded-xl shadow-md border-2 border-neutral-200" role="img" aria-label="Mapa de puntos de venta de La Sal de El Puerto"></div>

<!-- Datos del mapa serializados para el script -->
<script type="application/json" id="map-data" set:html={JSON.stringify({ puntos, lat, lng, zoom })} />

<style>
  @import 'leaflet/dist/leaflet.css';
</style>

<script>
  import L from 'leaflet';

  const raw = document.getElementById('map-data')?.textContent ?? '{}';
  const { puntos, lat, lng, zoom } = JSON.parse(raw);

  const container = document.getElementById('mapa-puntos');
  if (container && puntos?.length) {
    const map = L.map('mapa-puntos', { zoomControl: false }).setView([lat, lng], zoom);

    // Botones de zoom accesibles (sin href="#")
    const zoomDiv = document.createElement('div');
    zoomDiv.setAttribute('role', 'group');
    zoomDiv.setAttribute('aria-label', 'Controles de zoom del mapa');
    zoomDiv.style.cssText = 'position:absolute;top:10px;left:10px;z-index:1000;display:flex;flex-direction:column;gap:2px;';
    const btnIn = document.createElement('button');
    btnIn.type = 'button'; btnIn.textContent = '+'; btnIn.setAttribute('aria-label', 'Acercar mapa');
    btnIn.style.cssText = 'width:30px;height:30px;font-size:18px;background:#fff;border:2px solid #ccc;border-radius:4px;cursor:pointer;line-height:1;';
    btnIn.addEventListener('click', () => map.zoomIn());
    const btnOut = document.createElement('button');
    btnOut.type = 'button'; btnOut.textContent = '−'; btnOut.setAttribute('aria-label', 'Alejar mapa');
    btnOut.style.cssText = 'width:30px;height:30px;font-size:18px;background:#fff;border:2px solid #ccc;border-radius:4px;cursor:pointer;line-height:1;';
    btnOut.addEventListener('click', () => map.zoomOut());
    zoomDiv.appendChild(btnIn); zoomDiv.appendChild(btnOut);
    container.appendChild(zoomDiv);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 19,
    }).addTo(map);

    const emojis: Record<string, string> = { libreria: '📚', bar: '☕', asociacion: '🏘️', otro: '📍' };

    puntos.forEach((p: any) => {
      const emoji = emojis[p.tipo] ?? '📍';
      const icono = L.divIcon({
        className: '',
        html: `<div style="background:#ffde59;color:#1a1a1a;border-radius:50%;width:38px;height:38px;display:flex;align-items:center;justify-content:center;font-size:17px;box-shadow:0 3px 10px rgba(0,0,0,.35);border:2.5px solid #1a1a1a;">${emoji}</div>`,
        iconSize: [38, 38],
        iconAnchor: [19, 38],
        popupAnchor: [0, -40],
      });

      L.marker([p.latitud, p.longitud], { icon: icono })
        .addTo(map)
        .bindPopup(
          `<div style="min-width:180px;font-family:sans-serif;">
            <div style="background:#ffde59;margin:-12px -12px 10px;padding:10px 12px;border-radius:4px 4px 0 0;">
              <strong style="font-size:14px;color:#1a1a1a;">${p.nombre}</strong>
            </div>
            <span style="font-size:12px;color:#555;">📍 ${p.direccion}</span>
            ${p.horario ? `<br><span style="font-size:11px;color:#888;margin-top:4px;display:block;">🕐 ${p.horario}</span>` : ''}
          </div>`,
          { maxWidth: 240 }
        );
    });
  }
</script>
