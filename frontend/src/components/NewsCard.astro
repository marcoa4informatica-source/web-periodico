---
import type { Noticia } from '@/lib/directus';
import { getImageUrl } from '@/lib/directus';

interface Props {
  noticia: Noticia;
  featured?: boolean;
}

const { noticia, featured = false } = Astro.props;
const imageUrl = getImageUrl(noticia.imagen_destacada, featured ? 1200 : 600, featured ? 630 : 400);
const categoria = noticia.categoria;
const fecha = new Date(noticia.fecha_publicacion).toLocaleDateString('es-ES', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---

{featured ? (
  <article class="card group grid md:grid-cols-2 gap-0">
    <a href={`/noticias/${noticia.slug}`} class="overflow-hidden">
      {imageUrl
        ? <img src={imageUrl} alt={noticia.titulo} class="w-full h-64 md:h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
        : <div class="w-full h-64 md:h-full bg-neutral-100 flex items-center justify-center">
            <svg class="w-12 h-12 text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
      }
    </a>
    <div class="p-6 md:p-8 flex flex-col justify-center">
      <div class="flex items-center gap-3 mb-3">
        {categoria && <span class="text-xs font-semibold text-neutral-900 bg-accent-light px-2.5 py-1 rounded-full uppercase tracking-wide">{categoria}</span>}
        <span class="text-xs text-neutral-500">{fecha}</span>
      </div>
      <a href={`/noticias/${noticia.slug}`}>
        <h2 class="font-heading text-xl md:text-2xl font-bold text-neutral-900 mb-3 leading-snug group-hover:text-neutral-900 transition-colors">{noticia.titulo}</h2>
      </a>
      <p class="text-neutral-600 text-sm leading-relaxed line-clamp-3">{noticia.resumen}</p>
      <a href={`/noticias/${noticia.slug}`} class="mt-5 text-sm font-semibold text-neutral-900 hover:text-neutral-600 flex items-center gap-1 transition-colors">
        Leer más
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </article>
) : (
  <article class="card group flex flex-col">
    <a href={`/noticias/${noticia.slug}`} class="overflow-hidden">
      {imageUrl
        ? <img src={imageUrl} alt={noticia.titulo} class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
        : <div class="w-full h-48 bg-neutral-100 flex items-center justify-center">
            <svg class="w-10 h-10 text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
      }
    </a>
    <div class="p-5 flex flex-col flex-1">
      <div class="flex items-center gap-2 mb-2">
        {categoria && <span class="text-xs font-semibold text-neutral-900 bg-accent-light px-2 py-0.5 rounded-full uppercase tracking-wide">{categoria}</span>}
        <span class="text-xs text-neutral-500">{fecha}</span>
      </div>
      <a href={`/noticias/${noticia.slug}`}>
        <h3 class="font-heading font-bold text-neutral-900 mb-2 leading-snug group-hover:text-neutral-900 transition-colors line-clamp-2">{noticia.titulo}</h3>
      </a>
      <p class="text-neutral-600 text-sm leading-relaxed line-clamp-2 flex-1">{noticia.resumen}</p>
      <a href={`/noticias/${noticia.slug}`} class="mt-4 text-xs font-semibold text-neutral-900 hover:text-neutral-600 flex items-center gap-1 transition-colors">
        Leer más <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </article>
)}
