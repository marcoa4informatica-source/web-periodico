---
import type { ConfiguracionWeb, RedSocial } from '@/lib/directus';

interface Props {
  config: ConfiguracionWeb;
  redes: RedSocial[];
}

const { config, redes } = Astro.props;
const instagram = redes.find(r => r.plataforma.toLowerCase() === 'instagram') ?? null;

const iconos: Record<string, string> = {
  instagram: `<svg aria-hidden="true" focusable="false" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  facebook: `<svg aria-hidden="true" focusable="false" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
  twitter: `<svg aria-hidden="true" focusable="false" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  x: `<svg aria-hidden="true" focusable="false" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  youtube: `<svg aria-hidden="true" focusable="false" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  tiktok: `<svg aria-hidden="true" focusable="false" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>`,
  email: `<svg aria-hidden="true" focusable="false" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>`,
};
---

<footer class="bg-neutral-900 text-neutral-300 mt-16 relative overflow-hidden">
  <!-- Franja amarilla superior -->
  <div class="h-1.5 bg-accent"></div>

  <!-- Salero decorativo de fondo — flota en la esquina derecha -->
  <div class="absolute bottom-0 right-0 pointer-events-none select-none" aria-hidden="true">
    <img
      src="/salero.png"
      alt=""
      class="w-72 md:w-96 h-auto opacity-20"
      style="mix-blend-mode: lighten; transform: rotate(-10deg) translate(15%, 10%);"
      loading="lazy"
    />
  </div>

  <div class="container-main py-14 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">

      <!-- Sobre el periódico — col más ancha -->
      <div class="md:col-span-5">
        <a href="/" class="inline-block mb-5">
          <img
            src="/logoB.png"
            alt={config.nombre_periodico || 'La Sal de El Puerto'}
            class="h-24 w-auto brightness-0 invert"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
          />
          <span class="font-display text-3xl text-white tracking-wide" style="display:none;">
            {config.nombre_periodico}
          </span>
        </a>
        <p class="text-sm leading-relaxed text-neutral-400 max-w-xs">
          {config.descripcion || 'El periódico de El Puerto de Santa María. Noticias locales, independientes y cercanas.'}
        </p>
        {redes.length > 0 && (
          <div class="flex gap-3 mt-6">
            {redes.map((red) => (
              <a
                href={red.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={red.plataforma}
                class="p-2.5 rounded-full bg-neutral-800 hover:bg-accent transition-colors text-neutral-300 hover:text-neutral-900"
                set:html={iconos[red.plataforma.toLowerCase()] ?? ''}
              />
            ))}
          </div>
        )}
      </div>

      <!-- Navegación -->
      <nav aria-label="Navegación del pie de página" class="md:col-span-3">
        <h2 class="text-accent font-heading font-semibold mb-5 text-xs tracking-widest uppercase">Secciones</h2>
        <ul class="space-y-2.5 text-sm">
          {[
            ['/', 'Inicio'],
            ['/noticias', 'Noticias'],
            ['/archivo', 'Ediciones'],
            ['/acerca', 'Acerca de nosotros'],
            ['/hazte-socio', 'Hazte socio'],
            ['/encuentranos', 'Encuéntranos'],
          ].map(([href, label]) => (
            <li>
              <a href={href} class="hover:text-accent transition-colors flex items-center gap-2 group">
                <span class="w-1 h-1 rounded-full bg-neutral-600 group-hover:bg-accent transition-colors shrink-0"></span>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contacto -->
      <div class="md:col-span-4">
        <h2 class="text-accent font-heading font-semibold mb-5 text-xs tracking-widest uppercase">Contacto</h2>
        <ul class="space-y-3 text-sm text-neutral-400">
          {config.email && (
            <li class="flex items-center gap-3">
              <svg class="w-4 h-4 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <a href={`mailto:${config.email}`} class="hover:text-white transition-colors">{config.email}</a>
            </li>
          )}
          {instagram && (
            <li class="flex items-center gap-3">
              <svg class="w-4 h-4 shrink-0 text-accent" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
              <a href={instagram.url} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">@lasaldeelpuerto</a>
            </li>
          )}
          {config.telefono && (
            <li class="flex items-center gap-3">
              <svg class="w-4 h-4 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <span>{config.telefono}</span>
            </li>
          )}
          {config.direccion && (
            <li class="flex items-start gap-3">
              <svg class="w-4 h-4 shrink-0 mt-0.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>{config.direccion}</span>
            </li>
          )}
        </ul>
      </div>
    </div>

    <!-- Línea y copyright -->
    <div class="border-t border-neutral-800 mt-12 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-neutral-400">
      <span>&copy; {new Date().getFullYear()} {config.nombre_periodico || 'La Sal de El Puerto'}. Todos los derechos reservados.</span>
      <div class="flex gap-5">
        <a href="/aviso-legal" class="hover:text-neutral-300 transition-colors">Aviso legal</a>
        <a href="/privacidad" class="hover:text-neutral-300 transition-colors">Política de privacidad</a>
      </div>
    </div>
  </div>
</footer>
