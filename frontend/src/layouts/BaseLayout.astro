---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';
import { getConfiguracion, getRedesSociales } from '@/lib/directus';

interface Props {
  title: string;
  description?: string;
  ogImage?: string | null;
}

const { title, description, ogImage } = Astro.props;

let config = { nombre_periodico: 'El Periódico', descripcion: '', logo: null, email: '', telefono: null, direccion: null };
let redes: { id: string; plataforma: string; url: string; activa: boolean }[] = [];

try {
  [config, redes] = await Promise.all([getConfiguracion(), getRedesSociales()]);
} catch {
  // Directus no disponible aún, se usan valores por defecto
}

const siteName = config.nombre_periodico;
const siteDesc = description ?? config.descripcion;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteDesc} />

    <title>{title} | {siteName}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={siteDesc} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/logo.png" />

    <!-- Umami Analytics (sin cookies, compatible RGPD) -->
    {import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
      <script
        async
        defer
        data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
        src={`${import.meta.env.PUBLIC_UMAMI_URL}/script.js`}
      ></script>
    )}

    <!-- Preconnect fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;500;600;700;800&family=Source+Sans+3:wght@400;600;700&display=swap" />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Skip to main content: primer elemento del body, visible solo al recibir foco -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100]
             focus:px-4 focus:py-2 focus:bg-neutral-900 focus:text-accent focus:font-heading
             focus:font-bold focus:rounded-md focus:shadow-lg focus:outline-none"
    >
      Saltar al contenido
    </a>
    <Header config={config} />
    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer config={config} redes={redes} />
  </body>
</html>
